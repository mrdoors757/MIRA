[Unit]
Description=MIRA social network
After=network.target

[Service]
Type=simple
User=mira
WorkingDirectory=/var/www/mira
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/mira.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
